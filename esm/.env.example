# Spring reads this file as Java properties after it is copied to .env.
# No export, no quotes. Use DB_URL, DB_USERNAME, DB_PASSWORD environment
# variables instead on deployed servers.
DB_URL=jdbc:postgresql://localhost:5432/esm
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-database-password
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1

# Supabase session pooler: copy HOST and PROJECT_REF from Dashboard > Connect.
# DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
# DB_USERNAME=postgres.PROJECT_REF
# DB_PASSWORD=your-database-password
