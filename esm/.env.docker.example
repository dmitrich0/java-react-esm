# Copy to .env.docker and replace HOST, PROJECT_REF and the database password.
# Raw Docker env file: no quotes, no export, no backslash escaping.
# Password characters such as $ and # are kept literally.
DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=replace-with-your-database-password
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1
