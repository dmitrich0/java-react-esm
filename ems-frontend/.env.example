# Full backend API URL, including /api, without a trailing slash.
BACKEND_API_URL=https://backend-nu-lilac-29.vercel.app/api
# For a local backend: BACKEND_API_URL=http://localhost:8080/api

# Local Vite development server port.
DEV_PORT=4200

# HTTP port inside the Docker container (Vercel defaults to 80).
PORT=80
